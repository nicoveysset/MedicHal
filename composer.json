{
    "name": "nicoveysset/medichal",
    "description": "API REST de prise de rendez-vous médicaux",
    "type": "project",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php tests/run_tests.php",
        "seed": "@php bin/seed.php",
        "start": "@php -S 127.0.0.1:8000 -t public public/index.php",
        "swagger": "@start"
    }
}